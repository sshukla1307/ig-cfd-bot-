# Copy this file to .env and fill in your real values.
# .env is gitignored -- it will never be committed.

IG_USERNAME=your_ig_platform_username_not_email
IG_PASSWORD=your_ig_password
IG_API_KEY=your_ig_api_key

OPENAI_API_KEY=
BRAVE_API_KEY=
FRED_API_KEY=

# Kill switches -- leave both unset/false for local dry-run testing.
# Only cfd_trading.yml (the GitHub Actions workflow) sets these to "true".
IG_LIVE_TRADING_ENABLED=false
IG_LIVE=false
